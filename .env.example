# Copie este arquivo para .env e preencha com valores reais.
# NUNCA commite o arquivo .env (ele já está no .gitignore).

# Chave secreta do Django. Gere uma nova, por exemplo:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=

# "True" ou "False". Deve ser "False" em produção.
DEBUG=False

# String de conexão do banco Postgres (ex.: Neon), formato:
# postgresql://usuario:senha@host/banco?sslmode=require
DATABASE_URL=

# Chave da API da OpenAI, usada pelo app "ai" (SGEAgent). Opcional.
OPENAI_API_KEY=

# Token secreto exigido pelo endpoint /api/reset-demo/ para resetar os dados de demonstração.
RESET_TOKEN=

# "True" para habilitar o modo de demonstração pública (bloqueia troca de senha,
# criação/edição de usuários e configurações administrativas).
DEMO_MODE=False
