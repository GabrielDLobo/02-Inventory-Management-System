# URL base da API (prefixo /api/v1). Em desenvolvimento, o proxy do Vite já
# encaminha /api para o backend Django, então o padrão funciona sem alterar
# nada aqui.
VITE_API_BASE_URL=/api/v1

# Alvo do proxy de desenvolvimento (usado só pelo vite.config.ts, não é
# exposto ao navegador). Aponte para onde o "python manage.py runserver"
# estiver escutando.
API_PROXY_TARGET=http://localhost:8000
